# Quadlet named-volume unit for the Overnet authority relay event store.
#
# Install alongside overnet-authority-relay.container in the systemd unit search
# path (rootless: ~/.config/containers/systemd/). Because VolumeName is set
# below, the created podman volume is named `overnet-authority-relay-store`
# verbatim (without the systemd- prefix Quadlet would add by default). The
# .container unit references this unit by its file name
# (overnet-authority-relay.volume).
[Unit]
Description=Overnet authority relay event store volume

[Volume]
VolumeName=overnet-authority-relay-store
