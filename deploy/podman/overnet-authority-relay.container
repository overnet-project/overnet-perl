# Quadlet unit for the Overnet authority relay (rootless podman).
#
# This runs the SAME image as the generic relay (overnet-relay), but overrides
# the entrypoint to launch the authoritative hosted-channel (NIP-29) relay
# instead. Build the image once from relay-perl/deploy/podman/Containerfile.
#
# Install into the systemd unit search path and reload:
#
#   mkdir -p ~/.config/containers/systemd
#   cp overnet-authority-relay.container overnet-authority-relay.volume \
#      ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start overnet-authority-relay
#
[Unit]
Description=Overnet authority relay (rootless podman)
Documentation=https://github.com/overnet-project/relay-perl
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=overnet-authority-relay
Image=localhost/overnet-relay:latest

# Launch the authority relay entrypoint from the shared relay image. The
# entrypoint is overridden via PodmanArgs rather than the Quadlet Entrypoint=
# key, which only exists in podman 5.0+; PodmanArgs works on older Quadlet too.
PodmanArgs=--entrypoint=perl

# Persistent event store. The reference must match the sibling unit's file name
# (overnet-authority-relay.volume); that unit sets
# VolumeName=overnet-authority-relay-store, so the actual podman volume is named
# overnet-authority-relay-store. The mount path matches --store-file below.
Volume=overnet-authority-relay.volume:/var/lib/overnet/authority-relay:Z

# Publish the WebSocket listener on loopback only. Front it with a
# TLS-terminating reverse proxy for public exposure, or change the bind address.
PublishPort=127.0.0.1:7448:7448

# Authority relay invocation.
#
# --relay-url participates in authorization (delegation grants reference it), so
# set it to the public wss:// URL that IRC servers and clients actually use.
#
# By design NO snapshot pubkey is trusted by default, which means every 39xxx
# group-metadata snapshot is rejected until you authorize one or more snapshot
# signers with repeated --snapshot-pubkey <64-hex> arguments.
Exec=/opt/overnet/relay-perl/bin/overnet-authority-relay.pl \
  --host 0.0.0.0 \
  --port 7448 \
  --relay-url ws://127.0.0.1:7448 \
  --grant-kind 14142 \
  --store-file /var/lib/overnet/authority-relay/store.json \
  --health-file /var/lib/overnet/authority-relay/health.json

# Liveness probe: the authority relay's WebSocket listener must accept a TCP
# connection. IO::Socket::INET is a core module, so this needs nothing but perl.
HealthCmd=perl -MIO::Socket::INET -e "IO::Socket::INET->new(PeerAddr => '127.0.0.1:7448', Timeout => 3) or exit 1"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=2
TimeoutStartSec=120

[Install]
WantedBy=default.target
